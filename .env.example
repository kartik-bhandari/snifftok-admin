# snifftok Admin Panel — environment variables
# Copy to .env.local

# Express API base URL (no trailing slash)
VITE_API_URL=http://localhost:5000

# Storefront URL — used for login redirect and logout redirect
VITE_STOREFRONT_URL=http://localhost:3000

# Set to 'true' to use MSW mocks in dev without a running API
VITE_USE_MOCKS=false
